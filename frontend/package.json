{
  "name": "questionwhiz-standalone-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "QuestionWhiz Standalone AI Generator",
  "author": "QuestionWhiz",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && npx electron-packager . QuestionWhiz --platform=win32 --arch=x64 --out=dist-electron --overwrite && node create-installer.cjs"
  },
  "build": {
    "appId": "com.questionwhiz.app",
    "productName": "QuestionWhiz",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": "portable"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/logo512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/logo512.png"
    }
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.1.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@supabase/supabase-js": "^2.106.0",
    "axios": "^1.6.0",
    "docx": "^9.3.0",
    "file-saver": "^2.0.5",
    "jspdf": "^3.0.1",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.0",
    "electron": "^27.0.0",
    "electron-builder": "^24.9.1",
    "electron-packager": "^17.1.2",
    "electron-winstaller": "^5.4.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "vite": "^5.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "wait-on": "^7.2.0"
  }
}
